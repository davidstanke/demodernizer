<!DOCTYPE html>
<html>
<head>
  <title>Legacy Bank - Intranet</title>
  <%= javascript_include_tag :defaults %>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }
    .container { background: white; padding: 20px; border: 1px solid #ccc; max-width: 800px; margin: auto; }
    h1 { color: #333; }
    h2 { color: #555; border-bottom: 1px solid #eee; padding-bottom: 5px; }
    #nav { margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #ddd; }
    #nav a { margin-right: 15px; color: #0066cc; text-decoration: none; font-weight: bold; }
    #nav a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Legacy Bank</h1>
    <div id="nav">
      <a href="#" onclick="showHome(); return false;">Home</a>
      <a href="#customers" onclick="showCustomers(); return false;">Customer Directory</a>
    </div>
    <%= yield %>
  </div>
</body>
</html>
